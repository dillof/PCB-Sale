#!/usr/bin/env python

import sys
import argparse

from packages.Handout import Handout
from packages.Messages import messages



def main():
    parser = argparse.ArgumentParser(description="Generate and compile handouts.")
    parser.add_argument("page", nargs="?", default="index", help="The page to generate the handout for.")
    parser.add_argument("-b", "--brief", action="store_true", help="Generate a brief version of the handout, omitting parts list.")
    args = parser.parse_args()
    page = args.page
    brief = args.brief
    handout = Handout(page, brief=brief)

    if not messages.ok:
        sys.exit(1)

    handout.write()
    handout.compile()

if __name__ == "__main__":
    main()
